
# Redis (Upstash en producción)
REDIS_URL=rediss://default:TOKEN@HOST:6379
# Local: redis://localhost:6379/0

# URL del backend de producción (para el enlace de descarga del job)
RENDER_URL=http://localhost:8000

# DB PostgreSQL
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=typeormdb
DB_PORT=5432
# Producción (Neon): DATABASE_URL=postgresql://user:pass@host:5432/db

# Cloudflare R2 (opcional: subir mockups a la nube)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=

# Almacenamiento local (solo desarrollo)
STORAGE_LOCAL_PATH=C:\Users\johan\Documents\mockups
